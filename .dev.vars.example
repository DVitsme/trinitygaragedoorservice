# Local secrets for the Cloudflare Workers runtime used by
# `pnpm preview` / `opennextjs-cloudflare`. Copy to `.dev.vars` (gitignored) and fill
# from .env.local. Plain `next dev` reads .env.local directly; these mirror the values
# for the Workers preview/runtime. Wire these into the contact route in Phase 2.

# Resend (contact / free-estimate email)
RESEND_API_KEY=
# Comma separated. Every address here receives every lead and they all see each other.
# Live since the 2026-08-04 handover: the two office Gmail accounts.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# OPTIONAL, and temporary. A silent monitoring copy during the office handover, comma separated.
# BCC rather than a second `to` on purpose: the office should not see an agency address in the
# recipient list of every customer enquiry, and a reply all would otherwise loop in a third party
# the customer never wrote to. Runtime only, so removing it is
# `wrangler secret delete CONTACT_BCC_EMAIL` with no rebuild and no deploy.
CONTACT_BCC_EMAIL=

# Cloudflare Turnstile (form spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://trinity-garage-door.workers.dev
